{
  "rules": [
    {
      "allowed": {
        "origins": ["*"],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "if-match", "if-none-match", "content-type"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag", "Content-Type"],
      "maxAgeSeconds": 86400
    }
  ]
}
